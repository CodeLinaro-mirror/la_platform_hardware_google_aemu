{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "*": [
        "../../../../../api/web/node_modules/@types/*",
        "../../../../../api/web/node_modules/*"
      ]
    },
    "typeRoots": ["../../../../../api/web/node_modules/@types"],
    "types": ["node", "react"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "_ts_out",
    "_test_out",
    "tests"
  ]
}
