{
  "aemu-harness": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "__EMU_DEV_CLI_BIN__ harness hook --event session-start",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "__EMU_DEV_CLI_BIN__ harness hook --event pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__EMU_DEV_CLI_BIN__ harness hook --event pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__EMU_DEV_CLI_BIN__ harness hook --event post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "__EMU_DEV_CLI_BIN__ harness hook --event stop",
        "timeout": 15
      }
    ]
  }
}
