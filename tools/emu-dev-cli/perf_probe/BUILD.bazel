load("@rules_java//java:defs.bzl", "java_library")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "perf_probe_lib",
    srcs = glob(["src/**/*.java"]),
    javacopts = [
        "--release",
        "11",
    ],
    deps = [
        "@prebuilt_android_sdk//:android_jar",
    ],
)

py_binary(
    name = "build_apk",
    srcs = ["build_apk.py"],
    main = "build_apk.py",
)

filegroup(
    name = "sdkhome",
    srcs = select({
        "@platforms//os:macos": ["@prebuilt_android_sdk//macosx:sdkhome"],
        "@platforms//os:windows": ["@prebuilt_android_sdk//windows:sdkhome"],
        "//conditions:default": ["@prebuilt_android_sdk//linux:sdkhome"],
    }),
)

genrule(
    name = "perf_probe_apk",
    srcs = [
        ":perf_probe_lib",
        "AndroidManifest.xml",
        "debug.pk8",
        "debug.x509.pem",
        "@prebuilt_android_sdk//common:platforms/android-36/android.jar",
        "@prebuilt_android_sdk//:d8_jar",
        ":sdkhome",
    ],
    outs = ["perf_probe.apk"],
    cmd = (
        "$(execpath :build_apk) " +
        "--java $(JAVA) " +
        "--input-jar $(location :perf_probe_lib) " +
        "--manifest $(location AndroidManifest.xml) " +
        "--android-jar $(location @prebuilt_android_sdk//common:platforms/android-36/android.jar) " +
        "--d8-jar $(location @prebuilt_android_sdk//:d8_jar) " +
        "--key-pk8 $(location debug.pk8) " +
        "--cert-pem $(location debug.x509.pem) " +
        "--output $@ " +
        "$(locations :sdkhome)"
    ),
    toolchains = ["@rules_java//toolchains:current_java_runtime"],
    tools = [":build_apk"],
)
