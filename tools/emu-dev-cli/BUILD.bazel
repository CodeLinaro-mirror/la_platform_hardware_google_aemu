load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "emu_dev_cli_lib",
    srcs = glob([
        "src/**/*.py",
        "workflows/**/*.py",
    ]),
    data = glob(
        [
            "src/templates/*.md",
            "workflows/**/*.yaml",
            "workflows/**/*.yml",
            "workflows/**/*.md",
        ],
        allow_empty = True,
    ),
    imports = [
        ".",
        "src",
    ],
    deps = [
        requirement("PyYAML"),
    ],
)

py_binary(
    name = "emu-dev-cli-backend",
    srcs = ["src/__main__.py"],
    imports = ["src"],
    main = "src/__main__.py",
    deps = [
        ":emu_dev_cli_lib",
    ],
)

cc_binary(
    name = "emu-dev-cli",
    srcs = ["src/launcher.cpp"],
    data = [":emu-dev-cli-backend"],
)

[
    py_test(
        name = f.replace("tests/", "").replace(".py", ""),
        srcs = [f],
        imports = ["src"],
        deps = [
            ":emu_dev_cli_lib",
        ],
    )
    for f in glob(["tests/*_test.py"])
]

test_suite(
    name = "all_tests",
    tests = [
        f.replace("tests/", "").replace(".py", "")
        for f in glob(["tests/*_test.py"])
    ],
)
