load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "gadgets_lib",
    srcs = [
        "install.py",
        "pane_title/zellij_pane_title.py",
    ],
    data = [
        "pane_title/zellij_pane_title.md",
    ],
    imports = ["."],
)

py_binary(
    name = "install",
    srcs = ["install.py"],
    main = "install.py",
    deps = [":gadgets_lib"],
)

py_test(
    name = "gadgets_test",
    srcs = ["gadgets_test.py"],
    imports = ["."],
    deps = [":gadgets_lib"],
)
