load("@rules_python//python:defs.bzl", "py_binary")
load(
    ":defs.bzl",
    "tidy_enabled_flag",
    "tidy_exclude_tags_flag",
    "tidy_line_filter_flag",
    "tidy_regex_flag",
    "tidy_source_flag",
)

package(
    default_applicable_licenses = ["//:license"],
)

# Flag to globally enable/disable clang-tidy analysis and testing.
tidy_enabled_flag(
    name = "clang_tidy_enabled",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enable_clang_tidy_setting",
    flag_values = {
        ":clang_tidy_enabled": "true",
    },
    visibility = ["//visibility:public"],
)

# Flags used by clang-tidy aspect and report rules.
tidy_source_flag(
    name = "clang_tidy_check_files",
    build_setting_default = "goldfish",
    visibility = ["//visibility:public"],
)

tidy_regex_flag(
    name = "clang_tidy_regex",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

tidy_line_filter_flag(
    name = "clang_tidy_line_filter",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "default_tidy_config",
    srcs = [".clang-tidy"],
    visibility = ["//visibility:public"],
)

label_flag(
    name = "clang_tidy_config",
    build_setting_default = ":default_tidy_config",
    visibility = ["//visibility:public"],
)

tidy_exclude_tags_flag(
    name = "clang_tidy_exclude_tags",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "run-clang-tidy",
    srcs = ["run_clang_tidy.py"],
    main = "run_clang_tidy.py",
    visibility = ["//visibility:public"],
    deps = ["@pypi_aemu//pyyaml"],
)
