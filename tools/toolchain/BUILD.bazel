load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":amc.bzl", "amc_generator", "amc_pkg_config", "amc_toolchain")
load(":self.bzl", "py_binary_with_self_label")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "amc_common_lib",
    srcs = [
        "src/aemu/__init__.py",
        "src/aemu/command.py",
        "src/aemu/jsonc.py",
        "src/aemu/log.py",
        "src/aemu/process/__init__.py",
        "src/aemu/process/runner.py",
        "src/aemu/util.py",
    ],
    imports = ["src"],
)

py_library(
    name = "amc_toolchain_lib",
    srcs = [
        "src/aemu/buildbot_utils.py",
        "src/aemu/process/bazel.py",
        "src/aemu/process/cmake.py",
        "src/aemu/toolchain.py",
        "src/aemu/toolchains/__init__.py",
        "src/aemu/toolchains/binary_patcher.py",
        "src/aemu/toolchains/darwin_generator.py",
        "src/aemu/toolchains/factory.py",
        "src/aemu/toolchains/linux_arm_generator.py",
        "src/aemu/toolchains/linux_generator.py",
        "src/aemu/toolchains/mingw_to_msvc_lib.py",
        "src/aemu/toolchains/package_config_pc.py",
        "src/aemu/toolchains/toolchain_generator.py",
        "src/aemu/toolchains/windows_generator.py",
    ],
    data = ["src/aemu/process/introspection.cquery.bzl"],
    imports = ["src"],
    deps = [
        ":amc_common_lib",
        "@bazel_tools//tools/python/runfiles",
    ],
)

