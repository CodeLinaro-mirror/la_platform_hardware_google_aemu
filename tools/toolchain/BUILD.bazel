cc_binary(
    name = "hello",
    srcs = ["src/hello.c"],
)

# Build a test_lib
cc_library(
    name = "test_lib",
    srcs = ["tests/test_lib.c"],
    hdrs = ["tests/test_lib.h"],
    includes = ["tests"],
)

# Generate a pkg-config definition for test_lib
amc_pkg_config(
    name = "test_lib_pc",
    package_name = "test-lib",
    library = ":test_lib",
    version = "1.0.0",
)

# Generate a toolchain for the test generation
amc_toolchain(
    name = "test_toolchain",
    target_platform = "linux",
    tool_versions = ":test_tool_versions.json",
)

# Run a test meson to bazel generation
amc_generator(
    name = "test_generator",
    srcs = ["README.md"],
    config = "//tools/toolchain/tests/amc/simple:build-config.jsonc",
    packages = [":test_lib_pc"],
    target_platform = "linux",
    toolchain = ":test_toolchain",
)
