load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@grpc//bazel:python_rules.bzl", "py_grpc_library", "py_proto_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "emulator_stats_proto",
    srcs = ["emulator_stats.proto"],
    strip_import_prefix = "",
    deps = [
        "@protobuf//:empty_proto",
        "@protobuf//:wrappers_proto",
    ],
)

cc_proto_library(
    name = "emulator_stats_cc_proto",
    deps = [":emulator_stats_proto"],
)

cc_grpc_library(
    name = "emulator_stats_cc_grpc",
    srcs = [":emulator_stats_proto"],
    generate_mocks = True,
    grpc_only = True,
    deps = [":emulator_stats_cc_proto"],
)

py_proto_library(
    name = "emulator_stats_py_proto",
    deps = [":emulator_stats_proto"],
)

py_grpc_library(
    name = "emulator_stats_py_grpc",
    srcs = [":emulator_stats_proto"],
    grpc_library = "@pypi_aemu//grpcio",
    deps = [":emulator_stats_py_proto"],
)
