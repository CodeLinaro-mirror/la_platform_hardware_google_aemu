load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@grpc-java//:java_grpc_library.bzl", "java_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "waterfall_proto",
    srcs = ["waterfall.proto"],
    strip_import_prefix = "",
    deps = ["@protobuf//:empty_proto"],
)

cc_proto_library(
    name = "waterfall_cc_proto",
    deps = [":waterfall_proto"],
)

cc_grpc_library(
    name = "waterfall_cc_grpc",
    srcs = [":waterfall_proto"],
    generate_mocks = True,
    grpc_only = True,
    deps = [":waterfall_cc_proto"],
)

proto_library(
    name = "control_socket_proto",
    srcs = ["control_socket.proto"],
    strip_import_prefix = "",
)

cc_proto_library(
    name = "control_socket_cc_proto",
    deps = [":control_socket_proto"],
)

java_proto_library(
    name = "waterfall_java_proto",
    deps = [":waterfall_proto"],
)

java_grpc_library(
    name = "waterfall_java_grpc",
    srcs = [":waterfall_proto"],
    deps = [":waterfall_java_proto"],
)
