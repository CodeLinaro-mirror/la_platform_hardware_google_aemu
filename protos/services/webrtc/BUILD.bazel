load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@grpc//bazel:python_rules.bzl", "py_grpc_library", "py_proto_library")
load("@grpc-java//:java_grpc_library.bzl", "java_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "ice_config_proto",
    srcs = ["ice_config.proto"],
    strip_import_prefix = "",
    deps = ["@protobuf//:duration_proto"],
)

cc_proto_library(
    name = "ice_config_cc_proto",
    deps = [":ice_config_proto"],
)

py_proto_library(
    name = "ice_config_py_proto",
    deps = [":ice_config_proto"],
)

proto_library(
    name = "rtc_service_proto",
    srcs = ["rtc_service.proto"],
    strip_import_prefix = "",
    deps = ["@protobuf//:empty_proto"],
)

cc_proto_library(
    name = "rtc_service_cc_proto",
    deps = [":rtc_service_proto"],
)

cc_grpc_library(
    name = "rtc_service_cc_grpc",
    srcs = [":rtc_service_proto"],
    generate_mocks = True,
    grpc_only = True,
    deps = [":rtc_service_cc_proto"],
)

py_proto_library(
    name = "rtc_service_py_proto",
    deps = [":rtc_service_proto"],
)

py_grpc_library(
    name = "rtc_service_py_grpc",
    srcs = [":rtc_service_proto"],
    grpc_library = "@pypi_aemu//grpcio",
    deps = [":rtc_service_py_proto"],
)

proto_library(
    name = "rtc_service_v2_proto",
    srcs = ["rtc_service_v2.proto"],
    strip_import_prefix = "",
    deps = [
        ":ice_config_proto",
        "@protobuf//:any_proto",
        "@protobuf//:empty_proto",
    ],
)

cc_proto_library(
    name = "rtc_service_v2_cc_proto",
    deps = [":rtc_service_v2_proto"],
)

cc_grpc_library(
    name = "rtc_service_v2_cc_grpc",
    srcs = [":rtc_service_v2_proto"],
    generate_mocks = True,
    grpc_only = True,
    deps = [":rtc_service_v2_cc_proto"],
)

py_proto_library(
    name = "rtc_service_v2_py_proto",
    deps = [":rtc_service_v2_proto"],
)

py_grpc_library(
    name = "rtc_service_v2_py_grpc",
    srcs = [":rtc_service_v2_proto"],
    grpc_library = "@pypi_aemu//grpcio",
    deps = [":rtc_service_v2_py_proto"],
)

java_proto_library(
    name = "rtc_service_java_proto",
    deps = [":rtc_service_proto"],
)

java_grpc_library(
    name = "rtc_service_java_grpc",
    srcs = [":rtc_service_proto"],
    deps = [":rtc_service_java_proto"],
)

java_proto_library(
    name = "rtc_service_v2_java_proto",
    deps = [":rtc_service_v2_proto"],
)

java_grpc_library(
    name = "rtc_service_v2_java_grpc",
    srcs = [":rtc_service_v2_proto"],
    deps = [":rtc_service_v2_java_proto"],
)
