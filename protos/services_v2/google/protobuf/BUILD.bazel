load("//protos/services_v2:ts_proto.bzl", "ts_proto_group", "ts_proto_library")

package(default_visibility = ["//visibility:public"])

ts_proto_library(
    name = "empty_ts_proto",
    has_grpc = False,
    proto = "@protobuf//:empty_proto",
)

ts_proto_library(
    name = "field_mask_ts_proto",
    has_grpc = False,
    proto = "@protobuf//:field_mask_proto",
)

ts_proto_library(
    name = "timestamp_ts_proto",
    has_grpc = False,
    proto = "@protobuf//:timestamp_proto",
)

ts_proto_library(
    name = "duration_ts_proto",
    has_grpc = False,
    proto = "@protobuf//:duration_proto",
)

ts_proto_library(
    name = "any_ts_proto",
    has_grpc = False,
    proto = "@protobuf//:any_proto",
)

ts_proto_group(
    name = "protobuf_ts_proto",
    deps = [
        ":any_ts_proto",
        ":duration_ts_proto",
        ":empty_ts_proto",
        ":field_mask_ts_proto",
        ":timestamp_ts_proto",
    ],
)
