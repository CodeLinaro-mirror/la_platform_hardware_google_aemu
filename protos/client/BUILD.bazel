load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//protos/services_v2:ts_proto.bzl", "ts_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "grpc_endpoint_description_proto",
    srcs = ["grpc_endpoint_description.proto"],
    strip_import_prefix = "",
)

cc_proto_library(
    name = "grpc_endpoint_description_cc_proto",
    deps = [":grpc_endpoint_description_proto"],
)

java_proto_library(
    name = "grpc_endpoint_description_java_proto",
    deps = [":grpc_endpoint_description_proto"],
)

ts_proto_library(
    name = "grpc_endpoint_description_ts_proto",
    has_grpc = False,
    proto = ":grpc_endpoint_description_proto",
)
