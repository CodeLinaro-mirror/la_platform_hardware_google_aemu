{
  "name": "@android/web",
  "version": "0.1.0",
  "description": "Modern React component library and TypeScript SDK for Android Devices and Emulators",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./types/src/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test _test_out/tests/run_tests.js",
    "services": "bash scripts/sync_services.sh"
  },
  "keywords": [
    "android",
    "emulator",
    "webrtc",
    "grpc-web",
    "react",
    "goldfish"
  ],
  "author": "The Android Open Source Project",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@android/emulator-services": "*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@android/emulator-services": {
      "optional": true
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.9.0",
    "grpc-web": "^1.5.0",
    "loglevel": "^1.9.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "scheduler": "0.27.0",
    "esbuild-wasm": "^0.28.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-proto": "^2.6.1",
    "typescript": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "@bufbuild/protobuf": "2.9.0",
      "@types/node": "18.19.130"
    }
  }
}
