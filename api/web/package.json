{
  "name": "@android/web",
  "version": "0.1.0",
  "description": "Modern React component library and TypeScript SDK for Android Devices and Emulators",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./types/src/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test _test_out/tests/run_tests.js",
    "services": "bash scripts/sync_services.sh"
  },
  "keywords": [
    "android",
    "emulator",
    "webrtc",
    "grpc-web",
    "react",
    "goldfish"
  ],
  "author": "The Android Open Source Project",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@android/emulator-services": "*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "grpc-web": "^1.5.0",
    "loglevel": "^1.9.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.21.5",
    "scheduler": "^0.23.2",
    "esbuild-wasm": "^0.28.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ts-proto": "^2.6.1",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
