{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "outDir": "_test_out",
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "vitest": ["./tests/vitest_shim.ts"],
      "@/*": ["./src/*"],
      "@android/web": ["./src/index.ts"],
      "@android/web/*": ["./src/*"],
      "@android/emulator-services/*": [
        "./node_modules/@android/emulator-services/*"
      ]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
